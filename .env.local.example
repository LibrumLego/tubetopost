# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OpenAI
OPENAI_API_KEY=sk-...

# Server-only worker trigger (never use NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_WORKER_URL=
WORKER_SECRET=

# Local PoC only; also configure in Edge Function Secrets. Never NEXT_PUBLIC_.
SUPADATA_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Search Console ownership token; rendered as a public HTML meta tag.
GOOGLE_SITE_VERIFICATION=
